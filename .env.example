# Base de datos (Fase 1) — Postgres directo vía connection string.
# Desarrollo local: la del Postgres levantado en este entorno.
# Producción: la connection string de tu proyecto Supabase
# (Settings → Database → Connection string → "Transaction" o "Session" pooler).
DATABASE_URL=postgres://kaizen:kaizen_dev_pw@localhost:5432/kaizen_bigbuda

# Secreto para firmar la cookie de sesión (HMAC). Generar con:
#   openssl rand -hex 32
AUTH_SECRET=

# ClickUp API — Personal API Token del workspace (Fase 2).
# La bitácora (§3.3) ya usa esto en lib/clickup/client.ts; tareas/calendario
# de ClickUp (§3.5) siguen pendientes.
# CLICKUP_API_TOKEN=

# Anthropic API (Fase 4 — asistencia de IA en informes)
# ANTHROPIC_API_KEY=

# Google OAuth 2.0 — GSC + GA4 (Fase 3, sección 3.14)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Meta Graph API — System User token (Fase 3, sección 3.14)
# META_TOKEN=
