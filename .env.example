# Base de datos (Fase 1) — Postgres directo vía connection string.
# Desarrollo local: la del Postgres levantado en este entorno.
# Producción: la connection string de tu proyecto Supabase
# (Settings → Database → Connection string → "Transaction" o "Session" pooler).
DATABASE_URL=postgres://kaizen:kaizen_dev_pw@localhost:5432/kaizen_bigbuda

# Secreto para firmar la cookie de sesión (HMAC). Generar con:
#   openssl rand -hex 32
AUTH_SECRET=

# ClickUp API — Personal API Token del workspace (Fase 2).
# lib/clickup/client.ts ya usa esto para la bitácora (§3.3) y las tareas de
# calendario (§3.5); webhooks de taskStatusUpdated siguen pendientes.
# CLICKUP_API_TOKEN=

# URL pública de esta app (sin / al final). Usada para el link a la ficha
# del cliente en las tareas de ClickUp (§3.5, opcional ahí) y como base del
# redirect_uri de Google OAuth (§3.14, obligatoria para eso — tiene que
# coincidir exacto con un URI autorizado en el OAuth Client de Google Cloud).
# NEXT_PUBLIC_APP_URL=https://kaizen-bigbuda.vercel.app

# Secreto del cron de Vercel (§4.3, job de reintento de pendiente_sync,
# vercel.json). Vercel manda este valor solo como header Authorization al
# invocar el cron — generar con `openssl rand -hex 16` y agregarlo también
# como env var del proyecto en Vercel (mismo valor en ambos lados).
# CRON_SECRET=

# Anthropic API (Fase 4 — asistencia de IA en informes)
# ANTHROPIC_API_KEY=

# Google OAuth 2.0 — GSC + GA4 (Fase 3, sección 3.14). Authorization Code +
# PKCE (lib/google/oauth.ts): el refresh token se guarda en settings al
# conectar desde /ajustes, no acá — esto es solo el Client ID/Secret del
# OAuth Client de Google Cloud (APIs habilitadas: Search Console API +
# Analytics Data API; redirect URI autorizado: $NEXT_PUBLIC_APP_URL/api/auth/google/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Meta Graph API — token de System User (Fase 3, sección 3.14).
# META_TOKEN= es el default de la agencia. Si un cliente usa su propio
# System User (Business Manager del lado del cliente), agregar
# META_TOKEN_{CLAVE} donde {CLAVE} es el valor de clients.meta_token_key
# de ese cliente (ej. META_TOKEN_TECNY_STAND) — configurable desde la
# ficha del cliente.
# META_TOKEN=
